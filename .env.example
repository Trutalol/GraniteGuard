# Tiger Data / Postgres (Person 1) - used by train_and_predict.py
# Local Docker TimescaleDB:
#   docker run -d --name tsdb -p 5432:5432 -e POSTGRES_PASSWORD=pass timescale/timescaledb:latest-pg16
TIGER_DATABASE_URL=postgresql://postgres:pass@localhost:5432/postgres
# Tiger Cloud instead (copy the service URL from the Tiger console):
# TIGER_DATABASE_URL=postgresql://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require

# IBM Granite (Person 2) - Hugging Face models, run on a GPU (Colab T4)
GRANITE_EMBED_MODEL=ibm-granite/granite-embedding-30m-english
GRANITE_INSTRUCT_MODEL=ibm-granite/granite-3.3-2b-instruct
HF_TOKEN=
# Folder with the unzipped data.zip CSVs (defaults to data/raw)
DATA_DIR=

# Snowflake (Person 2) - key-pair service users, no passwords (see ai/snowflake_setup.sql)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=DATATHON_WH
SNOWFLAKE_DATABASE=DATATHON
SNOWFLAKE_SCHEMA=COPILOT
SNOWFLAKE_LOADER_KEY=keys/loader_key.p8
SNOWFLAKE_APP_KEY=keys/copilot_app_key.p8

# Copilot API (printed by `python -m ai.serve`; this is all the dashboard needs)
COPILOT_URL=
COPILOT_KEY=
